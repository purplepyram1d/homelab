| ============================================================
| Splunk SPL — Brute Force & Authentication Detection
| Index: windows | Source: Wazuh Universal Forwarder
| Tested on: Splunk 9.x homelab environment
| ============================================================

| ── 1. FAILED LOGON COUNT (EventCode 4625) ──────────────────
| Counts failed logons per user/host, flags count > 5
| Severity tiers: MEDIUM >5, HIGH >10, CRITICAL >20

index=windows EventCode=4625
| stats count by host, TargetUserName, WorkstationName, IpAddress
| where count > 5
| sort - count
| eval severity=case(count>20,"CRITICAL",count>10,"HIGH",count>5,"MEDIUM")
| table host, TargetUserName, WorkstationName, IpAddress, count, severity


| ── 2. SUCCESSFUL LOGON TRACKING (EventCode 4624) ───────────
| All successful logons with logon type breakdown

index=windows EventCode=4624
| stats count by host, TargetUserName, LogonType, IpAddress
| sort - count
| table host, TargetUserName, LogonType, IpAddress, count


| ── 3. PRIVILEGED ACTIVITY (EventCode 4672) ─────────────────
| Special privilege assignment — filters machine accounts and SYSTEM

index=windows EventCode=4672
  AND SubjectUserName!="*$"
  AND SubjectUserName!="SYSTEM"
| table _time, host, SubjectUserName, PrivilegeList
| sort - _time


| ── 4. ATTACK CHAIN — FAILED THEN SUCCESSFUL ────────────────
| Correlate 4625 failures followed by 4624 success for same user
| Useful for detecting successful brute force

index=windows (EventCode=4625 OR EventCode=4624)
| eval event_type=case(EventCode=4625,"FAIL",EventCode=4624,"SUCCESS")
| stats count(eval(event_type="FAIL")) as failures,
        count(eval(event_type="SUCCESS")) as successes
        by TargetUserName, IpAddress
| where failures > 3 AND successes > 0
| eval risk="Brute force likely succeeded"
| table TargetUserName, IpAddress, failures, successes, risk
